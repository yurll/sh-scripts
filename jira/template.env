# Template environment variables for Jira scripts
# Rename this file to ".env" and fill in your Jira credentials.
# Get your API token from https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_DOMAIN="yourcompany.atlassian.net"

JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN="your_api_token"
JIRA_PROJECT="DEVOPS"
# Required on some projects — set field id in local .env only (e.g. customfield_13903)
# JIRA_TEAM="your-team"
# JIRA_TEAM_FIELD="customfield_xxxxx"
